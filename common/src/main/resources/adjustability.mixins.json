  "minVersion": "0.8",
  "package": "io.github.safetimamovic.adjustability.mixin",
  "compatibilityLevel": "JAVA_${java_version}",
  "mixins": [
    "AnvilMenuMixin",
    "GrindstoneMenuMixin",
    "GrindstoneResultSlotMixin",
    "ItemEnchantmentsMixin",
