{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "${homepage}",
        "sources": "${sources}",
        "issues": "${issues}"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.github.safetimamovic.adjustability.AdjustabilityFabric"
        ],
        "client": [
            "io.github.safetimamovic.adjustability.AdjustabilityFabricClient"
        ],
        "jei_mod_plugin": [
            "io.github.safetimamovic.adjustability.compat.jei.AdjustabilityJeiPlugin"
        ],
        "fabric-client-gametest": [
            "io.github.safetimamovic.adjustability.gametest.AdjustPanelClientGameTest",
            "io.github.safetimamovic.adjustability.gametest.SwitchGifClientGameTest"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": "${fabric_loader_requirement}",
        "fabric-api": "${fabric_api_requirement}",
        "forgeconfigapiport": "${forgeconfigapiport_requirement}",
        "minecraft": "${minecraft_version_range_fabric}",
        "java": ">=${java_version}"
    }
}
